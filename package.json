{
  "name": "zoto-music-script",
  "version": "0.1.0",
  "description": "Download audio from YouTube and create Yoto Make Your Own playlists",
  "packageManager": "npm@11.20.0",
  "type": "module",
  "bin": {
    "zoto-music": "./src/cli.ts"
  },
  "scripts": {
    "start": "node src/cli.ts",
    "test": "node --test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run knip && npm test"
  },
  "engines": {
    "node": ">=26"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "knip": "^6.44.2",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "dependencies": {
    "music-metadata": "^12.3.5"
  },
  "overrides": {
    "minimatch@^10.0.0": "^11.0.4"
  }
}
