{
  "name": "zoto-music-script",
  "version": "0.1.0",
  "description": "Download audio from YouTube and create Yoto Make Your Own playlists",
  "packageManager": "npm@11.19.0",
  "type": "module",
  "bin": {
    "zoto-music": "./src/cli.ts"
  },
  "scripts": {
    "start": "node src/cli.ts",
    "test": "node --test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "engines": {
    "node": ">=26"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "eslint": "^10.10.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0"
  },
  "dependencies": {
    "music-metadata": "^11.14.0"
  }
}
